<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>MIQ.Perf</AssemblyName>
    <RootNamespace>MIQ.Perf</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Optimised binary so timings match the shipping plugin as closely as possible. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MIQ.Core\MIQ.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same libdeflate.dll bundled with the plugin; copy to our output dir so
         Libdeflate.TryLoad() finds it beside the exe. -->
    <None Include="..\QuickLook.Plugin.MIQ\native\libdeflate.dll"
          Link="libdeflate.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
